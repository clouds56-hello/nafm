{
  "name": "nafm-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "agents:build": "cargo run --locked -p nafm-xtask -- build-agents",
    "agents:check": "cargo run --locked -p nafm-xtask -- check-agents",
    "agents:ensure": "cargo run --locked -p nafm-xtask -- ensure-agents",
    "dev": "vite",
    "mock": "vite --host localhost --port 14243",
    "test:atlas": "playwright test",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
